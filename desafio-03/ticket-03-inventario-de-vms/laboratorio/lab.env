# Configuração comum dos scripts do laboratório (ADR 005). Lido por `source`.
# O projeto vem da configuração ativa do gcloud; nada aqui é segredo.

PROJETO="${PROJETO:-$(gcloud config get-value project 2>/dev/null)}"
REGIAO="${REGIAO:-us-east1}"
ZONA="${ZONA:-us-east1-b}"

VM="inventario-lab"
REDE="inventario-lab-rede"
SUBREDE="inventario-lab-subrede"
FAIXA_SUBREDE="10.10.0.0/24"
FIREWALL="inventario-lab-ssh-operador"
TIPO_MAQUINA="e2-small"
FAMILIA_IMAGEM="ubuntu-2404-lts-amd64"
PROJETO_IMAGEM="ubuntu-os-cloud"

USUARIO_ADMIN="labadmin"      # prepara o host; tem sudo pelo agente do GCP
USUARIO_COLETA="coleta"       # usado pela ferramenta; criado por useradd, sem sudo
COMENTARIO_COLETA="coleta@metacortex-platform"

NODE_EXPORTER_VERSAO="1.12.1"

LAB_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CHAVES="$LAB_DIR/.chaves"      # fora do git (.gitignore)
ESTADO="$LAB_DIR/.estado"      # fora do git: IP, known_hosts, fingerprint
mkdir -p "$CHAVES" "$ESTADO"

ip_externo() {
  gcloud compute instances describe "$VM" --project "$PROJETO" --zone "$ZONA" \
    --format='value(networkInterfaces[0].accessConfigs[0].natIP)'
}

# Executa um script remoto como root pela conta administrativa, com a chave de host já fixada
# no known_hosts do laboratório (nunca aceita chave nova).
# Uso: admin_sudo <script-remoto> [VAR=valor ...]
admin_sudo() {
  local script="$1"; shift
  local ip; ip="$(cat "$ESTADO/ip")"
  # O script vai dentro de uma função chamada com stdin em /dev/null: com `bash -s`, um comando
  # que lesse o stdin (apt, dpkg) engoliria o resto do script.
  {
    for atribuicao in "$@"; do printf '%q\n' "$atribuicao" | sed 's/^/export /'; done
    echo 'principal() {'
    cat "$script"
    echo '}'
    echo 'principal < /dev/null'
  } | ssh -i "$CHAVES/admin" \
      -o UserKnownHostsFile="$ESTADO/known_hosts" -o StrictHostKeyChecking=yes \
      -o IdentitiesOnly=yes -o BatchMode=yes \
      "$USUARIO_ADMIN@$ip" 'sudo bash -s'
}
